# URLs públicas
NEXT_PUBLIC_SITE_URL=https://encarteoferta.com.br
NEXT_PUBLIC_APP_URL=https://app.encarteoferta.com.br

# API do Encarte Oferta (GET /plans). Sem ela, a página usa src/mocks/plans.ts
NEXT_PUBLIC_API_URL=http://localhost:3340

# Meta Pixel. Sem ela, usa o Pixel de produção definido em src/content/site.ts
NEXT_PUBLIC_META_PIXEL_ID=

# Blog (/blog): posts do PLS Blog Manager, lidos no servidor. Todas opcionais:
# sem elas, usa a API de produção e o site com o domínio encarteoferta.com.br.
BLOG_MANAGER_API_BASE_URL=https://blog-manager-api.plssistemas.com.br
BLOG_MANAGER_SITE_ID=
BLOG_MANAGER_SITE_DOMAIN=
